{
  "name": "ai-todo-cli",
  "version": "0.4.4",
  "description": "CLI tool for AI agents to interact with ai-todo",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strzhao/ai-todo.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/strzhao/ai-todo/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/strzhao/ai-todo/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ai-todo": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
